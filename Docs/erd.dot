digraph ERD {
  graph [rankdir=LR, splines=true, nodesep=0.7, ranksep=1.3, fontname="Helvetica", labelloc=t, fontsize=20,
         label="University Course Registration and Academic Management System - ERD"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, dir=both];

  departments [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>departments</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">name (unique)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">code (unique)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">head_lecturer_id (unique)</TD></TR>
    </TABLE>>];

  lecturers [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>lecturers</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">first_name</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">last_name</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email (unique)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">department_id</TD></TR>
    </TABLE>>];

  courses [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>courses</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">code (unique)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">title</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">credits</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">department_id</TD></TR>
    </TABLE>>];

  lecturer_courses [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#7F6000" COLSPAN="2"><FONT COLOR="white"><B>lecturer_courses (join table)</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">lecturer_id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK, FK</B></TD><TD ALIGN="LEFT">course_id</TD></TR>
    </TABLE>>];

  students [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>students</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">student_number (unique)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">first_name</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">last_name</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">email (unique)</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">department_id</TD></TR>
    </TABLE>>];

  student_profiles [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#1F4E79" COLSPAN="2"><FONT COLOR="white"><B>student_profiles</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">date_of_birth</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">gender</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">phone_number</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">address</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">student_id (unique)</TD></TR>
    </TABLE>>];

  registrations [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#385723" COLSPAN="2"><FONT COLOR="white"><B>registrations (join entity)</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">student_id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">course_id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">registration_date</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">academic_year</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">semester</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">grade</TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT"><I>unique (student_id, course_id,</I></TD></TR>
      <TR><TD COLSPAN="2" ALIGN="LEFT"><I>academic_year, semester)</I></TD></TR>
    </TABLE>>];

  // Department 1 - N Course
  departments -> courses   [label="offers", arrowtail=teetee, arrowhead=crowodot];
  // Department 1 - N Lecturer
  departments -> lecturers [label="employs", arrowtail=teetee, arrowhead=crowodot];
  // Department 1 - N Student
  departments -> students  [label="admits", arrowtail=teetee, arrowhead=crowodot];
  // Department 1 - 1 Lecturer (head)
  lecturers -> departments [label="is head of", arrowtail=teeodot, arrowhead=teeodot, style=dashed];
  // Lecturer M - N Course through join table
  lecturers -> lecturer_courses [label="teaches", arrowtail=teetee, arrowhead=crowodot];
  courses   -> lecturer_courses [label="taught by", arrowtail=teetee, arrowhead=crowodot];
  // Student 1 - 1 Profile
  students -> student_profiles [label="has", arrowtail=teetee, arrowhead=teetee];
  // Student 1 - N Registration, Course 1 - N Registration
  students -> registrations [label="makes", arrowtail=teetee, arrowhead=crowodot];
  courses  -> registrations [label="receives", arrowtail=teetee, arrowhead=crowodot];
}
